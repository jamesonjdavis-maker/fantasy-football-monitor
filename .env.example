# Copy to `.env` for local runs. In GitHub Actions these come from Secrets
# instead (see .github/workflows/monitor.yml). Never commit the real .env.

# ---------- ESPN ----------
# MULTI-LEAGUE (preferred): one line, all leagues. Cookies below are shared.
#   Format:  Label:leagueId:teamId, Label2:leagueId2:teamId2
#   Example: ESPN_LEAGUES=BBL:1436101602:3, Dynasty:99887766:5
# The Label shows up in your alerts so you know which league each item is from.
ESPN_LEAGUES=
# SINGLE-LEAGUE fallback (used only if ESPN_LEAGUES is empty):
# League ID from the URL: .../leagues/{ESPN_LEAGUE_ID}
ESPN_LEAGUE_ID=
# Your team's numeric ID within the league (1, 2, 3, ...). Find it in the URL
# when viewing your team, or in the standings. If omitted, the first team is used.
ESPN_TEAM_ID=
# ONLY for private leagues: cookies from a logged-in espn.com browser session.
# DevTools → Application → Cookies → espn.com → copy `espn_s2` and `SWID`.
ESPN_S2=
ESPN_SWID=
# Optional: override the NFL season year (defaults to the current season).
ESPN_YEAR=

# ---------- Sleeper (public API, no cookies) ----------
SLEEPER_LEAGUE_ID=
# Identify your roster with EITHER your numeric user_id OR your username.
SLEEPER_USER_ID=
SLEEPER_USERNAME=

# ---------- Alerting ----------
# ntfy (default): pick a hard-to-guess topic name, subscribe to it in the ntfy
# app, and set the same name here. Anyone who knows the topic can read/post to
# it, so make it unguessable (e.g. jameson-ff-a7x9k2).
NTFY_TOPIC=
# Optional: only if you self-host ntfy. Defaults to https://ntfy.sh
NTFY_SERVER=
# Discord (optional alternative/addition): Server Settings → Integrations →
# Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# ---------- Options ----------
# Set to 1/true to always send an alert (handy for testing the webhook).
ALWAYS_NOTIFY=
# Where snapshots are stored (defaults to ./data).
DATA_DIR=data
